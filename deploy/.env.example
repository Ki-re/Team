# Copiar a deploy/.env en el servidor (203.0.113.10) y rellenar.
# deploy/.env NUNCA debe entrar al repo (ver .gitignore).

# --- Seguridad del gateway LiteLLM ---
LITELLM_MASTER_KEY=sk-team-CAMBIA_ESTO_por_algo_largo_y_aleatorio
LITELLM_SALT_KEY=CAMBIA_ESTO_TAMBIEN_aleatorio_y_distinto
UI_USERNAME=admin
UI_PASSWORD=CAMBIA_ESTA_PASSWORD

# --- Postgres (estado de virtual keys, UI, presupuestos) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_TAMBIEN
POSTGRES_DB=litellm

# --- tier-fast (Groq / Cerebras) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- tier-coder (OpenRouter, varias keys para round-robin + Mistral como
# 3ª familia de modelo distinta, más valiosa para el consenso que una 3ª
# key de OpenRouter) ---
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
MISTRAL_KEY=

# --- tier-context (Gemini Flash / Llama Scout vía OpenRouter) ---
# el modelo Llama Scout reutiliza OPENROUTER_KEY_1 (una key de OpenRouter
# no está atada a un tier); no hace falta una key de contexto separada.
GEMINI_API_KEY=

# --- tier-premium (fallback API cuando agy no responde) ---
# agy (Antigravity CLI) NO necesita API key — usa el login de la cuenta
# Google Pro del usuario vía subprocess. Este fallback reutiliza
# GEMINI_API_KEY de arriba; solo define GEMINI_PRO_API_KEY aparte si
# quieres un proyecto/cuota de Google distinto para el fallback premium.

# --- MCP de búsqueda web (Tavily, solo usada por team_ask cuando Claude
# pasa allow_web_search=True; ver Fase 7 del plan) ---
# Brave Search API exige tarjeta de crédito incluso para el free tier —
# descartado. Tavily da 1000 créditos/mes que se renuevan, sin tarjeta:
# https://app.tavily.com (crea cuenta, copia la API key).
# Guarda la URL COMPLETA de su MCP hospedado, key incluida como query
# param — así es como Tavily espera su endpoint remoto:
# https://mcp.tavily.com/mcp/?tavilyApiKey=tvly-TU_KEY_AQUI
TAVILY_MCP_URL=
