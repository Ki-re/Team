# Copiar a deploy/.env en el servidor (203.0.113.10) y rellenar.
# deploy/.env NUNCA debe entrar al repo (ver .gitignore).

# --- Seguridad del gateway LiteLLM ---
LITELLM_MASTER_KEY=sk-team-CAMBIA_ESTO_por_algo_largo_y_aleatorio
LITELLM_SALT_KEY=CAMBIA_ESTO_TAMBIEN_aleatorio_y_distinto
UI_USERNAME=admin
UI_PASSWORD=CAMBIA_ESTA_PASSWORD

# --- Postgres (estado de virtual keys, UI, presupuestos) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_TAMBIEN
POSTGRES_DB=litellm

# --- tier-fast (Groq / Cerebras) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- tier-coder (OpenRouter, varias keys para round-robin) ---
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_KEY_3=

# --- tier-context (Gemini Flash / Llama Scout vía OpenRouter o API directa) ---
GEMINI_API_KEY=
OPENROUTER_KEY_CONTEXT=

# --- tier-premium (fallback API cuando agy no responde) ---
GEMINI_PRO_API_KEY=
