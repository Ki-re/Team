# Copy to deploy/.env on the server where you deploy the gateway, and fill in.
# deploy/.env must NEVER enter the repo (see .gitignore).

# --- LiteLLM gateway security ---
LITELLM_MASTER_KEY=sk-team-CHANGE_THIS_to_something_long_and_random
LITELLM_SALT_KEY=CHANGE_THIS_TOO_random_and_different
UI_USERNAME=admin
UI_PASSWORD=CHANGE_THIS_PASSWORD

# --- Postgres (virtual keys, UI, budgets state) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_TOO
POSTGRES_DB=litellm

# --- tier-fast (e.g. Groq) ---
GROQ_API_KEY=

# --- tier-coder (e.g. OpenRouter, several keys for round-robin, plus a
# provider from a different model family for real diversity in the
# cross-validation consensus matrix) ---
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
MISTRAL_KEY=

# --- tier-context (e.g. Gemini) ---
GEMINI_API_KEY=

# --- tier-premium (API fallback for when agy doesn't respond) ---
# agy (Antigravity CLI) needs no API key of its own — it uses the
# operator's own Google Pro account login via subprocess. This fallback
# reuses GEMINI_API_KEY above; only set a separate key here if you want a
# different Google project/quota for the premium fallback.

# --- Web search MCP (used only by team_ask when Claude passes
# allow_web_search=True) ---
# Point this at any hosted web-search MCP server your account has access
# to (Tavily's hosted server is one option: https://app.tavily.com). Store
# the FULL URL including any API key as a query param, since that's how
# most hosted MCP endpoints expect to be addressed, e.g.:
# https://mcp.tavily.com/mcp/?tavilyApiKey=YOUR_KEY_HERE
TAVILY_MCP_URL=
