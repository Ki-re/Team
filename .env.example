# Config del servidor MCP "team-mcp" en sí (no confundir con deploy/.env,
# que son los secretos del gateway LiteLLM en el servidor remoto).
# Copiar a .env en la raíz del repo. Este .env NUNCA debe commitearse.

# --- Gateway LiteLLM remoto ---
TEAM_GATEWAY_URL=http://203.0.113.10:4000
TEAM_GATEWAY_KEY=sk-team-... # virtual key o master key del gateway

# --- Antigravity CLI (tier premium) ---
# Ruta absoluta al ejecutable agy. Se deja explícita porque el CLI está
# recién instalado y aún no resuelve de forma fiable vía PATH en procesos
# nuevos. Si se deja vacío, el MCP intenta `shutil.which("agy")` y cae a
# rutas conocidas de la instalación de Antigravity antes de degradar al
# fallback de tier-premium (Gemini Pro vía gateway).
TEAM_AGY_PATH=C:\Users\Kire\AppData\Local\agy\bin\agy.exe
# Modelo a forzar en agy (opcional). Confirmado disponible en `agy models`:
# gemini-3.1-pro-high, claude-opus-4-6-thinking, claude-sonnet-4-6, etc.
# Vacío = usa el default de la propia CLI.
TEAM_AGY_MODEL=

# --- Sandbox de escritura ---
# Rutas (separadas por ';' en Windows) donde el MCP tiene permiso de
# escribir. Cualquier ruta fuera de esta whitelist es rechazada.
TEAM_SANDBOX_ROOTS=

# --- Presupuesto y telemetría ---
TEAM_TOKEN_BUDGET_DEFAULT=200000
TEAM_LEDGER_DB=.team_sandbox/ledger.sqlite3
TEAM_CACHE_DB=.team_sandbox/cache.sqlite3

# --- Modo de operación ---
# true = nunca escribe en disco, solo simula y devuelve el manifiesto
TEAM_DRY_RUN=false
