# Config for the team-mcp server itself (not to be confused with
# deploy/.env, which holds the LiteLLM gateway's secrets on the remote host).
# Copy this to .env in the repo root. That .env must NEVER be committed.

# --- Remote LiteLLM gateway ---
TEAM_GATEWAY_URL=http://<gateway-host>:4000
TEAM_GATEWAY_KEY=sk-team-... # virtual key or master key of the gateway

# --- Antigravity CLI (premium tier) ---
# Absolute path to the agy executable. Left explicit because a freshly
# installed CLI doesn't always resolve reliably via PATH in new processes.
# If left empty, the MCP tries `shutil.which("agy")` and falls back to
# known Antigravity install paths before degrading to the tier-premium
# API fallback (Gemini, via the gateway).
TEAM_AGY_PATH=
# Model to force in agy (optional). Check what's available with `agy models`.
# Empty = use the CLI's own default.
TEAM_AGY_MODEL=

# --- Write sandbox ---
# Paths (separated by ';' on Windows, ':' elsewhere) the MCP is allowed to
# write to. Anything outside this whitelist is rejected. The current
# working directory is always included automatically.
TEAM_SANDBOX_ROOTS=

# --- Budget and telemetry ---
TEAM_TOKEN_BUDGET_DEFAULT=200000
TEAM_LEDGER_DB=.team_sandbox/ledger.sqlite3
TEAM_CACHE_DB=.team_sandbox/cache.sqlite3

# --- Operating mode ---
# true = never writes to disk, only simulates and returns the manifest
TEAM_DRY_RUN=false
